# ==============================================================================
# Environment Configuration Template
# Duplicate this file as '.env' and adjust the variables to your local setup:
#   cp .env.example .env
# ==============================================================================

# Path to the root dataset folder (containing 'clear' and 'clouds' subdirectories)
# You can use a relative path (e.g. ./data_aug_3) or an absolute path.
DATASET_PATH=./data_aug_3

# Input image dimensions expected by the models
IMG_HEIGHT=64
IMG_WIDTH=64

# Training hyperparameters
BATCH_SIZE=32
RANDOM_SEED=42

# Optuna study configuration
OPTUNA_N_TRIALS=300

